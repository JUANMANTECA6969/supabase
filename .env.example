# URL del proyecto (Project Settings → API). Puede ser pública.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave secreta (sb_secret_… o service_role). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: la app no la usa (no hay lecturas desde el navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
